{
  "name": "petstown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local office for existing Codex agents",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx src/server/main.ts",
    "dev:all": "tsx scripts/dev.ts",
    "office": "tsx scripts/office.ts",
    "pets:fetch": "tsx scripts/fetch-pets.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
