{
  "name": "petstown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local office for existing Codex agents",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx src/server/main.ts",
    "dev:all": "tsx scripts/dev.ts",
    "office": "tsx scripts/office.ts",
    "pets:fetch": "tsx scripts/fetch-pets.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:e2e": "playwright test",
    "build:chatgpt": "tsx scripts/build-chatgpt.ts",
    "package:chatgpt": "tsx scripts/package-chatgpt.ts",
    "test:chatgpt": "tsx --test src/chatgpt/*.test.ts",
    "test:chatgpt:browser": "npm run build:chatgpt && playwright test --config tests/browser/chatgpt.config.ts",
    "check:chatgpt:plugin": "tsx scripts/check-chatgpt-plugin.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
